<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>انقراض تجربه | ترجمه و تلخیص مسعود شکری</title>
<meta name="description" content="ترجمه و تلخیص کتاب انقراض تجربه نوشتهٔ کریستین روزن با پرسشنامه، کاربرگ و پیشنهادات عملی.">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css">
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
<style>
:root{--fs:20px;--cfs:21px;--lh:1.95;--font:'Vazirmatn',Tahoma,sans-serif;--r:20px}
[data-theme=light]{--bg:#F6F0E4;--surface:#FFFDF8;--ink:#1E2B2F;--muted:#55656A;--acc:#2F5D62;--acc2:#C0703F;--border:#E0D3BA;--svgbg:#EFE6D3;--shadow:0 12px 34px rgba(60,45,20,.10)}
[data-theme=sepia]{--bg:#EFE2C8;--surface:#F8EFDD;--ink:#2B2219;--muted:#6B5A46;--acc:#6E4327;--acc2:#B5652F;--border:#D6C29C;--svgbg:#E6D5B5;--shadow:0 12px 34px rgba(80,55,20,.14)}
[data-theme=dark]{--bg:#11171A;--surface:#1A2326;--ink:#EDE6D6;--muted:#A3B3B1;--acc:#7FB3B0;--acc2:#E0A06F;--border:#2C3A3E;--svgbg:#213034;--shadow:0 12px 34px rgba(0,0,0,.45)}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{background:var(--bg);color:var(--ink);font-family:var(--font);font-size:var(--fs);line-height:var(--lh);min-height:100vh;display:flex;flex-direction:column;transition:background .3s,color .3s}
a{color:var(--acc)}
button,input,select,textarea{font:inherit;color:inherit}
header{position:sticky;top:0;z-index:50;background:var(--surface);border-bottom:1px solid var(--border);box-shadow:0 4px 18px rgba(0,0,0,.05)}
.hrow{max-width:1180px;margin:auto;display:flex;align-items:center;gap:14px;padding:12px 20px}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none;color:var(--ink);font-weight:900;font-size:1.15em;white-space:nowrap}
.brand img{width:44px;height:62px;object-fit:cover;border-radius:6px;box-shadow:0 4px 10px rgba(0,0,0,.25);background:var(--svgbg)}
.hact{margin-inline-start:auto;display:flex;gap:8px;align-items:center}
.pill{border:1.5px solid var(--border);background:var(--bg);border-radius:999px;padding:8px 16px;cursor:pointer;text-decoration:none;color:var(--ink);font-size:.92em;font-weight:700;white-space:nowrap;display:inline-flex;align-items:center;gap:6px}
.pill:hover,.pill.on{background:var(--acc);border-color:var(--acc);color:#fff}
.navrow{border-top:1px solid var(--border);background:var(--bg)}
.nav{max-width:1180px;margin:auto;display:grid;grid-template-columns:repeat(8,1fr);gap:4px;padding:6px 12px}
.nav a{text-align:center;padding:10px 6px;border-radius:12px;text-decoration:none;color:var(--ink);font-size:.9em;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.nav a:hover{background:var(--surface)}
.nav a.on{background:var(--acc);color:#fff}
main{flex:1;width:100%;max-width:1180px;margin:0 auto;padding:30px 20px 60px}
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:28px;box-shadow:var(--shadow)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:14px;padding:13px 22px;background:var(--acc);color:#fff;cursor:pointer;text-decoration:none;font-weight:800;transition:transform .15s,opacity .15s;font-size:1em}
.btn:hover{transform:translateY(-2px)}
.btn.ghost{background:transparent;color:var(--acc);border:1.5px solid var(--acc)}
.btn.warm{background:var(--acc2)}
.btn.sm{padding:8px 14px;font-size:.88em;border-radius:11px}
h1,h2,h3{line-height:1.5;margin:.2em 0 .5em}
h1{font-size:2.3em;font-weight:900}h2{font-size:1.7em}h3{font-size:1.3em;color:var(--acc)}
.muted{color:var(--muted)}
.grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(210px,1fr))}
.cover{width:100%;max-width:300px;border-radius:16px;box-shadow:0 22px 46px rgba(0,0,0,.28);display:block;aspect-ratio:2/3;object-fit:cover;background:linear-gradient(135deg,#2F5D62,#C0703F)}
.stat{background:var(--bg);border:1px solid var(--border);border-radius:16px;padding:16px;text-align:center}
.stat b{display:block;font-size:1.6em;color:var(--acc)}
.bar-wrap{height:12px;background:var(--bg);border:1px solid var(--border);border-radius:999px;overflow:hidden}
.bar-wrap>i{display:block;height:100%;background:linear-gradient(90deg,var(--acc),var(--acc2));border-radius:999px;transition:width .4s}
.hero{display:grid;grid-template-columns:minmax(0,260px) 1fr;gap:34px;align-items:center;max-width:880px;margin:0 auto}
.hero .info{min-width:0}
.hero h1{font-size:1.65em}
.hero .acts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-top:16px}
.hero .acts .btn{padding:10px 6px;font-size:.8em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0;border-radius:12px}
.hero .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:18px 0}
.acts{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}
.lbtn{display:flex;flex-direction:column;gap:4px;padding:16px 18px;border-radius:16px;border:1px solid var(--border);background:var(--surface);color:var(--ink);text-decoration:none;font-weight:800;box-shadow:var(--shadow);transition:transform .15s,border-color .15s}
.lbtn:hover{transform:translateY(-3px);border-color:var(--acc)}
.lbtn small{font-weight:400;color:var(--muted);font-size:.85em;direction:ltr;text-align:start;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.nbtn{display:flex;flex-direction:column;align-items:flex-start;gap:6px;padding:22px;border-radius:18px;border:1px solid var(--border);background:var(--surface);cursor:pointer;text-align:start;text-decoration:none;color:var(--ink);box-shadow:var(--shadow);transition:transform .15s,border-color .15s}
.nbtn:hover{transform:translateY(-3px);border-color:var(--acc)}
.nbtn b{font-size:1.2em;color:var(--acc)}
.nbtn small{color:var(--muted);font-size:.9em}
.sharebox{margin-top:16px;padding:18px;border-radius:16px;background:var(--bg);border:1px dashed var(--acc2)}
.sharebox p{margin:0 0 12px;white-space:pre-line}
.ch-card{display:flex;flex-direction:column;gap:14px;align-items:stretch;padding:16px;border-radius:18px;border:1px solid var(--border);background:var(--surface);text-decoration:none;color:var(--ink);box-shadow:var(--shadow)}
.ch-card svg{width:100%;height:auto;border-radius:14px}
.ch-card .meta{flex:1;min-width:0}
.ch-card p{margin:.3em 0;color:var(--muted);font-size:.92em;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tag{display:inline-block;font-size:.8em;padding:3px 12px;border-radius:999px;background:var(--bg);border:1px solid var(--border);color:var(--muted)}
.tag.done{background:var(--acc);color:#fff;border-color:var(--acc)}
.reader{max-width:840px;margin:auto}
.rhero{display:flex;gap:22px;align-items:center;flex-wrap:wrap;margin-bottom:22px}
.rhero svg{width:100%;max-width:380px;height:auto;border-radius:18px;display:block}
.rhero .txt{flex:1;min-width:230px}
.content{font-size:var(--cfs);text-align:justify}
.content p{margin:.8em 0}
.content ul{padding-inline-start:1.4em}
.content li{margin:.55em 0}
.content h3{margin-top:1.5em}
.check{display:inline-flex;align-items:center;gap:10px;padding:12px 18px;border-radius:14px;border:1.5px solid var(--acc);cursor:pointer;font-weight:800;background:var(--surface);user-select:none}
.check input{width:24px;height:24px;accent-color:var(--acc);cursor:pointer;margin:0}
.check.on{background:var(--acc);color:#fff}
.check.on input{accent-color:#fff}
.toolbar{display:flex;gap:12px;flex-wrap:wrap;align-items:center;justify-content:space-between;margin:24px 0}
.qslider{position:relative}
.qtrack{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;padding:6px 4px 18px;scrollbar-width:thin}
.qcard{flex:0 0 min(360px,86%);scroll-snap-align:start;border-radius:22px;padding:26px;min-height:250px;display:flex;flex-direction:column;position:relative;overflow:hidden;color:#fff;background:linear-gradient(150deg,var(--acc),#1d3b3e)}
.qcard.v2{background:linear-gradient(150deg,var(--acc2),#7a3f1e)}
.qcard.v3{background:linear-gradient(150deg,#3e4a5c,#1b2230)}
.qcard::after{content:"❝";position:absolute;inset-inline-end:14px;top:-16px;font-size:120px;opacity:.18;line-height:1}
.qgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:18px}
.qgrid .qcard{flex:none;min-height:230px}
.qgrid .qcard p{-webkit-line-clamp:unset;display:block;overflow:visible}
.qcard.v4{background:linear-gradient(150deg,#6B5B95,#3D3157)}
.qcard.v5{background:linear-gradient(150deg,#7A8F5A,#44542F)}
.qcard p{font-size:1.08em;line-height:1.95;margin:0 0 12px;flex:1;display:-webkit-box;-webkit-line-clamp:7;-webkit-box-orient:vertical;overflow:hidden;position:relative;z-index:1}
.qcard .src{font-size:.82em;opacity:.8;position:relative;z-index:1;margin-bottom:12px}
.qcard button{position:relative;z-index:1;align-self:flex-start;background:rgba(255,255,255,.18);border:1px solid rgba(255,255,255,.4);color:#fff;border-radius:11px;padding:8px 14px;cursor:pointer;font-weight:700}
.qnav{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:6px}
.qnav .arrow{width:46px;height:46px;border-radius:50%;border:1.5px solid var(--acc);background:var(--surface);color:var(--acc);font-size:1.2em;cursor:pointer}
.ql{background:var(--surface);border:1px solid var(--border);border-radius:18px;padding:22px;margin-bottom:14px;box-shadow:var(--shadow)}
form label{display:block;margin:14px 0 6px;font-weight:800}
.inp{width:100%;padding:13px 16px;border:1.5px solid var(--border);border-radius:13px;background:var(--bg);font-size:1em}
textarea.inp{min-height:140px;resize:vertical}
.q{padding:18px 0;border-bottom:1px dashed var(--border)}
.q p{margin:0 0 10px;font-weight:800;font-size:1.05em}
.opts{display:flex;gap:8px;flex-wrap:wrap}
.opts label{margin:0;font-weight:500;display:inline-flex;align-items:center;gap:6px;padding:9px 14px;border:1.5px solid var(--border);border-radius:999px;cursor:pointer;font-size:.95em;background:var(--bg)}
.opts label:has(input:checked){background:var(--acc);color:#fff;border-color:var(--acc)}
.opts input{accent-color:var(--acc)}
.result{margin-top:22px;padding:24px;border-radius:18px;background:var(--bg);border:2px solid var(--acc)}
.meter{height:16px;border-radius:999px;background:var(--surface);border:1px solid var(--border);overflow:hidden;margin:12px 0}
.meter i{display:block;height:100%;background:linear-gradient(90deg,var(--acc),var(--acc2))}
.sugg-group{margin:34px 0 10px}
.step{display:grid;grid-template-columns:auto 1fr;gap:14px;padding:18px;border:1px solid var(--border);border-radius:16px;background:var(--surface);margin:12px 0;cursor:pointer}
.step input{width:24px;height:24px;accent-color:var(--acc);margin-top:4px}
.step .t{font-weight:900;color:var(--acc)}
.step .s{margin-top:6px}
.step.done{opacity:.6}
.step.done .s{text-decoration:line-through}
.sheet{background:#FBF6EC;color:#1E2B2F;border:2px solid #2F5D62;border-radius:14px;padding:28px;max-width:820px;margin:auto}
.sheet .band{display:flex;gap:16px;align-items:center;background:linear-gradient(120deg,#DDEAE7,#F3DCCB);border-radius:12px;padding:16px;margin-bottom:18px}
.sheet .band img{width:70px;height:98px;object-fit:cover;border-radius:6px;box-shadow:0 4px 10px rgba(0,0,0,.2)}
.sheet .band h2{margin:0;font-size:1.45em;color:#2F5D62}
.sheet .band p{margin:4px 0 0;color:#55656A;font-size:.95em}
.sheet .fields{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;margin-bottom:12px}
.sheet .fields label{margin:0;font-size:.9em;color:#2F5D62}
.sheet .fields input{width:100%;border:0;border-bottom:1.5px solid #2F5D62;background:transparent;padding:6px 2px;font-size:1em}
table.ws{width:100%;border-collapse:collapse;margin:12px 0}
table.ws th,table.ws td{border:1px solid #CDBFA5;padding:8px;vertical-align:top}
table.ws th{background:#2F5D62;color:#fff;text-align:start;font-size:.9em}
table.ws tr:nth-child(even) td{background:#F4EEDF}
table.ws input,table.ws textarea{width:100%;background:transparent;border:0;outline:none;padding:4px;resize:none;font-size:.95em}
.sw{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px}
.sw label{border:2px solid var(--border);border-radius:16px;padding:12px;cursor:pointer;display:block;background:var(--surface);margin:0;font-weight:800}
.sw label.on{border-color:var(--acc);box-shadow:0 0 0 3px rgba(47,93,98,.2)}
.sw .chip{height:58px;border-radius:12px;margin-bottom:8px;border:1px solid var(--border)}
.setrow{margin:22px 0}
.setrow>label{font-weight:800;display:block;margin-bottom:8px;font-size:1.05em}
.links{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px}
.links a{display:block;text-align:center;padding:20px;border-radius:18px;border:1px solid var(--border);background:var(--surface);text-decoration:none;color:var(--ink);font-weight:900;box-shadow:var(--shadow);font-size:1.1em}
.links a span{display:block;font-weight:400;color:var(--muted);font-size:.8em;direction:ltr;margin-top:6px;word-break:break-all}
.welcome{min-height:76vh;display:grid;place-items:center}
.wgrid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,300px);gap:50px;align-items:center;max-width:780px;width:100%}
.wgrid .cover{max-width:300px;margin:auto}
.welcome{padding:0 28px}
.wtxt h1{font-size:2em}
.wtxt .go{margin-top:22px;font-size:1.2em;padding:16px 30px}
footer{border-top:1px solid var(--border);background:var(--surface);padding:24px 20px;margin-top:auto}
footer .inner{max-width:1180px;margin:auto;display:flex;gap:16px;flex-wrap:wrap;align-items:center;justify-content:space-between;font-size:.95em;color:var(--muted)}
footer .fl{display:flex;gap:10px;flex-wrap:wrap}
footer .fl a{color:var(--acc);text-decoration:none;font-weight:800;padding:6px 12px;border-radius:10px;border:1px solid var(--border);background:var(--bg)}
.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--ink);color:var(--surface);padding:12px 20px;border-radius:14px;z-index:90;box-shadow:var(--shadow);font-weight:700}
.empty{padding:30px;text-align:center;color:var(--muted)}
.sec-title{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin:34px 0 14px}
.toc a{color:var(--ink);text-decoration:none;display:block;padding:8px 0;border-bottom:1px dashed var(--border);cursor:pointer}
.toc a:hover{color:var(--acc)}
.bookpart{scroll-margin-top:150px;margin-top:50px;padding-top:10px;border-top:2px solid var(--border)}
.bookcover{display:grid;place-items:center;text-align:center;padding:40px 10px}
.bookcover .cover{max-width:320px}
@media (max-width:900px){
  .hero,.wgrid{grid-template-columns:1fr;text-align:center}
  .hero .cover,.wgrid .cover{margin:auto}
  .hero .stats{grid-template-columns:repeat(2,1fr)}
  .hero .acts{grid-template-columns:repeat(2,minmax(0,1fr))}
  .acts{justify-content:center}
  .nav{grid-template-columns:repeat(8,max-content);overflow-x:auto;justify-content:start;padding:6px 10px}
  .nav a{font-size:.85em}
  .ch-card p{white-space:normal}
  .rhero{justify-content:center;text-align:center}
  .hrow .pill span.lbl{display:none}
}
@media (max-width:560px){
  :root{--fs:18px;--cfs:19px}
  main{padding:18px 14px 50px}
  .card{padding:20px}
  h1{font-size:1.8em}
  .brand span{font-size:.95em}
  .qcard{flex-basis:88%}
  .sheet{padding:16px}
}
@page{size:A4 portrait;margin:12mm}
@media print{
  header,footer,.noprint,.toast{display:none!important}
  body{background:#fff;color:#000;font-size:12pt}
  main{padding:0;max-width:none}
  .sheet{border:0;box-shadow:none;max-width:none;padding:0;background:#FBF6EC;print-color-adjust:exact;-webkit-print-color-adjust:exact}
  .sheet .band{print-color-adjust:exact;-webkit-print-color-adjust:exact}
  table.ws th{print-color-adjust:exact;-webkit-print-color-adjust:exact}
  table.ws input,table.ws textarea{font-size:10pt}
}
</style>
</head>
<body>
<header>
  <div class="hrow">
    <a class="brand" href="#/home" id="brand"><img src="https://m.media-amazon.com/images/I/91JgpTQtemL._SL1500_.jpg" alt="جلد کتاب" onerror="this.style.visibility='hidden'"><span id="brandTxt"></span></a>
    <div class="hact">
      <button class="pill" id="langBtn" type="button"></button>
      <a class="pill" href="#/home" id="homeBtn">⌂ <span class="lbl" id="homeTxt"></span></a>
    </div>
  </div>
  <div class="navrow"><nav class="nav" id="nav"></nav></div>
</header>
<main id="app"><p class="muted" style="text-align:center;padding:80px 0">…</p></main>
<footer>
  <div class="inner">
    <div id="footInfo"></div>
    <div class="fl"><a href="#/toc" id="fBook"></a><a href="#/contact" id="fContact"></a><a href="#/share" id="fShare"></a></div>
  </div>
</footer>
